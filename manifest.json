{
  "manifest_version": 2,
  "core_api_major": 5,
  "package_version": "1.0.7",
  "id": "godot_party_default_3d_chess",
  "name": "3D 国际象棋",
  "kind": "minigame",
  "supported_systems": ["windows"],
  "entry": "game.tscn",
  "player_counts": [
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "introduction": "房主可选择国际象棋或中国象棋。两位棋手轮流走棋，其余玩家观战。国际象棋支持易位、吃过路兵与升变；中国象棋遵守九宫、河界、蹩马腿、塞象眼、炮架及将帅照面规则，将死或困毙获胜。中国象棋长将、长捉与无吃子回合不自动裁决，可协议和棋。胜1分，负0分，和棋各0.5分。",
  "cover": "assets/cover.svg",
  "dependencies": {
    "godot_party_default_protocol": "1.0.7"
  },
  "adapters": [
    {
      "id": "standard",
      "protocol": {
        "id": "godot_party_default_protocol",
        "api_major": 1,
        "min_api_minor": 0
      },
      "entry": "adapter.gd"
    }
  ],
  "localization": {
    "supported_locales": [
      "zh_Hans"
    ],
    "fallback_locale": "zh_Hans",
    "translations": {
      "zh_Hans": "i18n/zh_Hans.po"
    }
  },
  "config_schema": "settings.gd"
}
